/* ---------- cámara y proyección ---------- */
function rot(p,rx,ry,s){
 var x=p[0]*s,y=-p[1]*s,z=p[2]*s;
 var cy=Math.cos(ry*D),sy=Math.sin(ry*D);
 var x1=x*cy+z*sy,z1=-x*sy+z*cy;
 var cx=Math.cos(rx*D),sx=Math.sin(rx*D);
 return [x1,y*cx-z1*sx,y*sx+z1*cx];
}
function camFor(o){
 var s=o.s*K(),r=rot(o.f,o.rx,o.ry,s);
 return {rx:o.rx,ry:o.ry,s:s,px:-r[0],py:-r[1],ex:o.ex||0};
}
function render(){
 world.style.transform='translate('+cam.px+'px,'+cam.py+'px) rotateX('+cam.rx+'deg) rotateY('+cam.ry+'deg) scale('+cam.s+')';
 fls.forEach(function(w,i){if(w)w.style.transform='translate3d(0,'+(-(i-1)*cam.ex)+'px,0)';});
 var W=stage.clientWidth,H=stage.clientHeight;
 P.forEach(function(p){
  var y=p.pos[1]+(p.fl>1?(p.fl-1)*cam.ex:0);
  var r=rot([p.pos[0],y,p.pos[2]],cam.rx,cam.ry,cam.s);
  var f=PERSP/(PERSP-r[2]);
  p.el.style.transform='translate('+(W/2+(r[0]+cam.px)*f)+'px,'+(H/2+(r[1]+cam.py)*f)+'px) translate(-50%,-50%)';
  p.el.style.zIndex=Math.round(1000+r[2]);
 });
 var rex=$('#rex');if(+rex.value!==Math.round(cam.ex))rex.value=cam.ex;
}
function tweenTo(t,ms){
 cancelAnimationFrame(anim);ms=ms||1000;
 var a={rx:cam.rx,ry:cam.ry,s:cam.s,px:cam.px,py:cam.py,ex:cam.ex};
 t.ry=a.ry+(((t.ry-a.ry)%360+540)%360-180);
 var t0=performance.now();
 function step(now){
  var u=Math.min(1,(now-t0)/ms),e=u<.5?2*u*u:1-Math.pow(-2*u+2,2)/2;
  ['rx','ry','s','px','py','ex'].forEach(function(k){cam[k]=a[k]+(t[k]-a[k])*e;});
  render();if(u<1)anim=requestAnimationFrame(step);
 }
 anim=requestAnimationFrame(step);
}
