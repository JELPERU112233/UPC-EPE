
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Datacenter - Mapa Interactivo AR 3D</title>
<style>
:root{--bg:#030d18;--pn:#071a2b;--ln:#14405f;--cy:#29d3ff;--tx:#d9f1ff;--mu:#86abc4}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;height:100%;background:var(--bg);color:var(--tx);font-family:Arial,Helvetica,sans-serif;font-size:14px}
button,input,select{font-family:Arial,Helvetica,sans-serif}
.app{display:grid;grid-template-columns:1fr 350px;grid-template-rows:auto 1fr auto;height:100%}
header{grid-column:1/-1;padding:10px 16px;border-bottom:1px solid var(--ln);background:#05121f}
header h1{margin:0;font-size:17px;letter-spacing:.3px}
header p{margin:3px 0 0;color:var(--mu);font-size:12px}
footer{grid-column:1/-1;padding:7px 16px;border-top:1px solid var(--ln);background:#05121f;color:var(--mu);font-size:11px;text-align:center}
#stage,#panel{min-height:0}
#stage{position:relative;overflow:hidden;perspective:1700px;perspective-origin:50% 50%;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;
 background:radial-gradient(ellipse at 50% 42%,#0b2d49 0,#04121f 65%,#030d18 100%)}
#stage.drag{cursor:grabbing}
#video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
#stage.ar #video{display:block}
#stage.ar{background:#000}
#world{position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;will-change:transform}
.grp,.fl{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}
.bx{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}
.fc{position:absolute;left:50%;top:50%;display:block;border:1px solid var(--ed,rgba(255,255,255,.35));
 background:linear-gradient(var(--sh),var(--sh)),var(--c)}
.win .fc.fr,.win .fc.bk,.win .fc.lf,.win .fc.rt{
 background:repeating-linear-gradient(90deg,rgba(150,220,255,.20) 0 14px,transparent 14px 28px),linear-gradient(var(--sh),var(--sh)),var(--c)}
.fc.led{background:repeating-linear-gradient(180deg,rgba(60,255,140,.95) 0 2px,rgba(0,0,0,0) 2px 7px),linear-gradient(var(--sh),var(--sh)),var(--c)}
.pl{position:absolute;left:0;top:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px;font-weight:bold;letter-spacing:.5px;overflow:hidden}
.ground{background:linear-gradient(rgba(41,211,255,.13) 1px,transparent 1px) 0 0/40px 40px,linear-gradient(90deg,rgba(41,211,255,.13) 1px,transparent 1px) 0 0/40px 40px,rgba(8,36,58,.55);border:1px solid rgba(41,211,255,.4)}
.street{background:rgba(70,95,120,.35)}
.dash{background:repeating-linear-gradient(90deg,rgba(255,255,255,.45) 0 14px,transparent 14px 28px)}
.dash.v{background:repeating-linear-gradient(180deg,rgba(255,255,255,.45) 0 14px,transparent 14px 28px)}
.plate{background:linear-gradient(rgba(41,211,255,.13) 1px,transparent 1px) 0 0/20px 20px,linear-gradient(90deg,rgba(41,211,255,.13) 1px,transparent 1px) 0 0/20px 20px,rgba(8,40,66,.92)}
.mh{border-radius:50%;border:3px solid var(--c);background:rgba(0,0,0,.55);box-shadow:0 0 8px var(--c)}
.st{position:absolute;left:0;top:0}
.flow{background:repeating-linear-gradient(90deg,var(--c) 0 9px,rgba(255,255,255,.10) 9px 22px);background-size:22px 100%;animation:fl .7s linear infinite;box-shadow:0 0 7px var(--c);border-radius:3px}
.flowv{background:repeating-linear-gradient(180deg,var(--c) 0 9px,rgba(255,255,255,.10) 9px 22px);background-size:100% 22px;animation:flv .7s linear infinite;box-shadow:0 0 7px var(--c)}
.solid{background:var(--c);box-shadow:0 0 6px var(--c)}
@keyframes fl{to{background-position:22px 0}}
@keyframes flv{to{background-position:0 22px}}
#pins{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.pin{position:absolute;left:0;top:0;width:26px;height:26px;border-radius:50%;border:2px solid var(--pc,#29d3ff);background:rgba(3,13,24,.9);color:#fff;font-size:11px;font-weight:bold;cursor:pointer;pointer-events:auto;padding:0;display:flex;align-items:center;justify-content:center;animation:pp 2.2s infinite}
.pin:hover{background:var(--pc,#29d3ff);color:#000}
.pin::after{content:attr(data-t);position:absolute;left:50%;bottom:135%;transform:translateX(-50%);white-space:nowrap;background:#04202f;color:var(--tx);border:1px solid var(--ln);padding:3px 7px;border-radius:5px;font-size:11px;font-weight:normal;opacity:0;pointer-events:none;transition:opacity .15s}
.pin:hover::after{opacity:1}
@keyframes pp{0%{box-shadow:0 0 0 0 rgba(41,211,255,.55)}70%{box-shadow:0 0 0 12px rgba(41,211,255,0)}100%{box-shadow:0 0 0 0 rgba(41,211,255,0)}}
.lbl{position:absolute;left:0;top:0;font-size:11px;font-weight:bold;color:#a9d6ee;white-space:nowrap;pointer-events:none;text-shadow:0 0 5px #000,0 0 3px #000}
#hud{position:absolute;inset:8px;pointer-events:none;border:1px solid rgba(41,211,255,.22);z-index:4000}
#hud span{position:absolute;top:8px;left:12px;font-size:11px;letter-spacing:1.5px;color:var(--cy)}
#hud::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(41,211,255,.035) 0 1px,transparent 1px 4px)}
.ctl{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);display:flex;gap:6px;flex-wrap:wrap;justify-content:center;align-items:center;max-width:96%;z-index:5000}
.b{background:rgba(5,25,42,.9);border:1px solid var(--ln);color:var(--tx);padding:6px 10px;border-radius:6px;cursor:pointer;font-size:12px}
.b:hover{border-color:var(--cy)}
.b.on{background:#0c4a6a;border-color:var(--cy)}
.rng{display:flex;align-items:center;gap:6px;background:rgba(5,25,42,.9);border:1px solid var(--ln);border-radius:6px;padding:4px 10px;font-size:12px}
.rng input{width:110px;accent-color:#29d3ff}
#toast{position:absolute;top:34px;left:50%;transform:translateX(-50%);background:#052338;border:1px solid var(--cy);padding:7px 12px;border-radius:6px;font-size:12px;z-index:6000}
.tabs{display:flex;border-bottom:1px solid var(--ln);position:sticky;top:0;background:var(--pn);z-index:2}
.tabs button{flex:1;padding:10px 4px;background:none;border:0;border-bottom:2px solid transparent;color:var(--mu);cursor:pointer;font-size:12px}
.tabs button.on{color:var(--tx);border-bottom-color:var(--cy)}
.sec{padding:14px}
.sec h2{margin:0 0 6px;font-size:15px;color:var(--cy)}
.sec p{margin:0 0 10px;line-height:1.5;color:#c4e2f2}
.nav{display:flex;gap:6px;margin:10px 0}
.nav .b{flex:1}
.dots{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.dots button{width:26px;height:26px;border-radius:50%;border:1px solid var(--ln);background:#05121f;color:var(--tx);cursor:pointer;font-size:11px}
.dots button.on{background:var(--cy);color:#000}
.lay{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #0d2c44;cursor:pointer}
.lay input{accent-color:#29d3ff}
.sw{width:12px;height:12px;border-radius:3px;display:inline-block}
.cl{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid #0d2c44;color:var(--tx);padding:8px 2px;cursor:pointer;font-size:13px}
.cl:hover{background:#0a2840}
.cl i{font-style:normal;min-width:22px;height:22px;border-radius:50%;border:2px solid var(--pc);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:bold}
details{margin-top:12px;color:var(--mu);font-size:12px}
details img{width:100%;border:1px solid var(--ln);margin-top:6px}
#modal{position:fixed;inset:0;background:rgba(1,8,15,.72);z-index:9000;display:flex;align-items:center;justify-content:center;padding:14px}
#modal .card{position:relative;max-width:560px;width:100%;max-height:92vh;overflow:auto;background:#071a2b;border:1px solid var(--cy);border-radius:10px;padding:20px 22px;box-shadow:0 0 30px rgba(41,211,255,.25)}
#mx{position:absolute;top:8px;right:12px;background:none;border:0;color:var(--tx);font-size:26px;cursor:pointer}
.kick{font-size:11px;letter-spacing:2px;color:var(--mu);text-transform:uppercase}
#modal h2{margin:4px 30px 10px 0;font-size:19px;color:var(--cy)}
#modal h3{margin:14px 0 4px;font-size:13px;color:#fff}
#modal p{margin:0;line-height:1.55;color:#c4e2f2}
#modal ul{margin:0;padding-left:18px;line-height:1.55;color:#c4e2f2}
.src{margin-top:14px!important;padding:8px 10px;border-left:3px solid #ffb02e;background:#0b2236;font-size:11px;color:var(--mu)!important}
.acts{margin-top:14px}
@media(max-width:860px){.app{grid-template-columns:1fr;grid-template-rows:auto 1fr 42vh auto}#panel{border-left:0!important;border-top:1px solid var(--ln)}header p{display:none}}
#panel{border-left:1px solid var(--ln);background:var(--pn);overflow:auto}
</style>
</head>
<body>
<div class="app">
 <header>
  <h1>Datacenter ISP · Cableado estructurado — Caso 1: acometida eléctrica y fibra óptica</h1>
  <p>Arrastra para rotar · rueda o pellizco = zoom · Mayús+arrastrar o botón ✥ = mover · toca los marcadores numerados para ver cada componente</p>
 </header>

 <div id="stage">
  <video id="video" playsinline muted></video>
  <div id="world"></div>
  <div id="pins"></div>
  <div id="hud"><span>AR · HOLOGRAMA INTERACTIVO</span></div>
  <div id="toast" hidden></div>
  <div class="ctl">
   <button class="b" data-v="3d">3D</button>
   <button class="b" data-v="plan">Planta</button>
   <button class="b" data-v="front">Frente</button>
   <button class="b" data-v="side">Lateral</button>
   <button class="b" id="bpan">✥ Mover</button>
   <button class="b" id="bauto">⟳ Auto-rotar</button>
   <button class="b" id="bar">📷 Cámara AR</button>
   <button class="b" id="breset">Reiniciar</button>
   <label class="rng">Explosión de pisos <input type="range" id="rex" min="0" max="60" value="0"></label>
  </div>
 </div>

 <aside id="panel">
  <nav class="tabs">
   <button class="on" data-tab="tour">Recorrido</button>
   <button data-tab="layers">Capas</button>
   <button data-tab="comp">Componentes</button>
  </nav>
  <section class="sec" id="tab-tour">
   <div id="stepn" style="font-size:11px;color:var(--mu)"></div>
   <h2 id="stept"></h2>
   <p id="stepd"></p>
   <div class="nav"><button class="b" id="prev">◀ Anterior</button><button class="b" id="next">Siguiente ▶</button></div>
   <div class="dots" id="dots"></div>
   <details><summary>Plano de referencia (del HTML base)</summary>
    <img src="https://jelperu112233.github.io/UPC-EPE/S5/mapa_datacenter.png" alt="Plano del Datacenter" onerror="this.parentNode.hidden=true">
   </details>
  </section>
  <section class="sec" id="tab-layers" hidden>
   <h2>Capas</h2>
   <div id="layl"></div>
   <p style="margin-top:12px;font-size:12px;color:var(--mu)">Convención de la escena: energía entra por la Calle A (lado este); fibra ruta 1 por la Calle B (frente); fibra ruta 2 por la Calle C (posterior). El dibujo de texto de la respuesta anterior usaba otra rotulación de puntos cardinales: aquí lo importante es que las tres entradas van por lados distintos.</p>
  </section>
  <section class="sec" id="tab-comp" hidden>
   <h2>Componentes</h2>
   <div id="compl"></div>
  </section>
 </aside>

 <footer>© 2026 — Experiencia Técnica Interactiva. Fines educativos - UPC.</footer>
</div>

<div id="modal" hidden>
 <div class="card">
  <button id="mx" aria-label="Cerrar">×</button>
  <div class="kick">Componente</div>
  <h2 id="mt"></h2>
  <h3>Definición</h3><p id="md"></p>
  <h3>Uso y Función Principal</h3><p id="mu"></p>
  <h3>Equipos Reales (Marcas Reconocidas)</h3><ul id="me"></ul>
  <p class="src">Procedencia: conocimiento de entrenamiento + inferencia de buenas prácticas; no verificado con búsqueda web. Las marcas son ejemplos, no recomendaciones; contrasta modelos, cifras y normas (TIA-942, CNE, RNE) con fichas técnicas y la edición vigente.</p>
  <div class="acts"><button class="b" id="mf">Enfocar en 3D</button></div>
 </div>
</div>

<script>
(function(){
'use strict';
var D=Math.PI/180, PERSP=1700;
var $=function(s,r){return (r||document).querySelector(s);};
var stage=$('#stage'), world=$('#world'), pinsEl=$('#pins');
var C={pw:'#ff5a4d',gen:'#ffa534',f1:'#29d3ff',f2:'#ff58e0',fi:'#ffe14d',gr:'#3dff7a'};
var cam={rx:-24,ry:-32,s:.8,px:0,py:0,ex:0};
var G={}, fls=[], pins=[], anim=0;
var layers={bld:true,shell:true,eq:true,pw:true,f1:true,f2:true,fi:true,gnd:true,und:true,pins:true};
var K=function(){return Math.min(1,stage.clientWidth/1000);};

/* ---------- primitivas 3D ---------- */
function grp(k,parent){var g=document.createElement('div');g.className='grp L-'+k;(parent||world).appendChild(g);G[k]=g;return g;}
function box(par,o){
 var el=document.createElement('div');el.className='bx '+(o.cls||'');
 el.style.transform='translate3d('+o.x+'px,'+(-o.y)+'px,'+o.z+'px)';
 el.style.setProperty('--c',o.c||'#2a6');
 if(o.e)el.style.setProperty('--ed',o.e);
 var w=o.w,h=o.h,d=o.d;
 var defs=[['fr',w,h,'translateZ('+d/2+'px)','rgba(0,0,0,0)'],
  ['bk',w,h,'rotateY(180deg) translateZ('+d/2+'px)','rgba(0,0,0,.35)'],
  ['rt',d,h,'rotateY(90deg) translateZ('+w/2+'px)','rgba(0,0,0,.22)'],
  ['lf',d,h,'rotateY(-90deg) translateZ('+w/2+'px)','rgba(0,0,0,.42)'],
  ['tp',w,d,'rotateX(90deg) translateZ('+h/2+'px)','rgba(255,255,255,.12)'],
  ['bt',w,d,'rotateX(-90deg) translateZ('+h/2+'px)','rgba(0,0,0,.5)']];
 defs.forEach(function(f){
  if(o.hide&&o.hide.indexOf(f[0])>-1)return;
  var i=document.createElement('i');i.className='fc '+f[0]+(o.led===f[0]?' led':'');
  i.style.width=f[1]+'px';i.style.height=f[2]+'px';
  i.style.transform='translate(-50%,-50%) '+f[3];
  i.style.setProperty('--sh',f[4]);
  el.appendChild(i);
 });
 par.appendChild(el);return el;
}
function plane(par,o){
 var e=document.createElement('div');e.className='pl '+(o.cls||'');
 e.style.cssText='width:'+o.w+'px;height:'+o.d+'px;margin-left:'+(-o.w/2)+'px;margin-top:'+(-o.d/2)+'px;transform:translate3d('+o.x+'px,'+(-o.y)+'px,'+o.z+'px) rotateX(90deg);'+(o.css||'');
 if(o.t)e.textContent=o.t;
 par.appendChild(e);return e;
}
function path(par,pts,y,col,o){
 o=o||{};var w=o.w||5,cls=o.cls||'flow';
 for(var i=0;i<pts.length-1;i++){
  var x1=pts[i][0],z1=pts[i][1],x2=pts[i+1][0],z2=pts[i+1][1];
  var L=Math.hypot(x2-x1,z2-z1);if(L<.5)continue;
  var a=Math.atan2(z2-z1,x2-x1)/D;
  var el=document.createElement('div');el.className='st '+cls;
  el.style.cssText='width:'+L+'px;height:'+w+'px;margin-left:'+(-L/2)+'px;margin-top:'+(-w/2)+'px;--c:'+col+';transform:translate3d('+((x1+x2)/2)+'px,'+(-y)+'px,'+((z1+z2)/2)+'px) rotateX(90deg) rotateZ('+a+'deg)';
  par.appendChild(el);
 }
}
function vbar(par,x,z,y1,y2,col,w){
 w=w||5;var h=Math.abs(y2-y1),ym=(y1+y2)/2;
 [0,90].forEach(function(r){
  var el=document.createElement('div');el.className='st flowv';
  el.style.cssText='width:'+w+'px;height:'+h+'px;margin-left:'+(-w/2)+'px;margin-top:'+(-h/2)+'px;--c:'+col+';transform:translate3d('+x+'px,'+(-ym)+'px,'+z+'px) rotateY('+r+'deg)';
  par.appendChild(el);
 });
}

/* ---------- escena ---------- */
var gU=grp('und');
plane(gU,{x:0,z:0,y:-1,w:760,d:560,cls:'ground'});
plane(gU,{x:0,z:195,y:-.5,w:760,d:80,cls:'street'});
plane(gU,{x:0,z:-195,y:-.5,w:760,d:80,cls:'street'});
plane(gU,{x:262,z:0,y:-.5,w:75,d:560,cls:'street'});
plane(gU,{x:0,z:195,y:-.4,w:760,d:2,cls:'dash'});
plane(gU,{x:0,z:-195,y:-.4,w:760,d:2,cls:'dash'});
plane(gU,{x:262,z:0,y:-.4,w:2,d:560,cls:'dash v'});
[[-260,195,C.f1],[-160,160,C.f1],[-260,-195,C.f2],[-160,-160,C.f2],[270,-100,C.pw],[215,-100,C.pw]].forEach(function(m){
 plane(gU,{x:m[0],z:m[1],y:.3,w:16,d:16,cls:'mh',css:'--c:'+m[2]});
});
box(gU,{x:-350,y:16,z:195,w:22,h:32,d:16,c:'#1b8fb0',e:'rgba(255,255,255,.5)'});
box(gU,{x:-350,y:16,z:-195,w:22,h:32,d:16,c:'#b0328f',e:'rgba(255,255,255,.5)'});
box(gU,{x:345,y:35,z:-100,w:6,h:70,d:6,c:'#9aa7b3'});
box(gU,{x:340,y:60,z:-100,w:14,h:16,d:14,c:'#ff5a4d',e:'rgba(255,255,255,.5)'});

var gS=grp('shell');
box(gS,{x:0,y:32,z:0,w:400,h:64,d:260,c:'rgba(60,160,220,.09)',e:'rgba(120,220,255,.8)',hide:['tp','bt'],cls:'win'});
plane(gS,{x:0,z:0,y:.5,w:400,d:260,cls:'plate'});
function room(x,z,w,d,t,rgb){plane(gS,{x:x,z:z,y:1,w:w,d:d,t:t,css:'background:rgba('+rgb+',.14);border:1px dashed rgba('+rgb+',.85);color:rgb('+rgb+')'});}
room(-160,97.5,60,55,'ER1','41,211,255');
room(-160,-97.5,60,55,'ER2','255,88,224');
room(-70,0,60,60,'MDA','170,130,255');
room(32.5,0,135,124,'SALA DE SERVIDORES','110,180,255');
room(150,-92.5,80,65,'SUBESTACIÓN / TGBT','255,100,87');
room(150,-22.5,80,65,'UPS / BATERÍAS','255,165,52');
room(150,72.5,80,105,'GRUPO ELECTRÓGENO','255,214,64');

var gE=grp('eq');
function eq(x,z,w,h,d,c,ex){var o={x:x,y:h/2+1,z:z,w:w,h:h,d:d,c:c,e:'rgba(255,255,255,.45)'};if(ex)for(var k in ex)o[k]=ex[k];return box(gE,o);}
eq(165,-100,26,22,20,'#e0533f');
eq(125,-100,30,28,12,'#c9402f');
eq(125,-50,14,18,10,'#ffb02e');
eq(165,-28,30,30,20,'#ff8a3b');
eq(165,-2,34,20,20,'#b8742a');
eq(150,55,50,26,22,'#e8c32a');
eq(150,105,50,16,24,'#8d7d26');
eq(92,-46,8,26,8,'#ff7a5a');
eq(92,46,8,26,8,'#ff7a5a');
eq(92,0,12,30,26,'#3aa0c8');
for(var i=0;i<5;i++){var rx=-10+20*i;eq(rx,-30,16,36,24,'#2b4f7a',{led:'fr'});eq(rx,30,16,36,24,'#2b4f7a',{led:'bk'});}
eq(-85,-12,14,36,22,'#7a4fd0');eq(-70,-12,14,36,22,'#7a4fd0');eq(-55,-12,14,36,22,'#7a4fd0');
eq(-85,14,14,36,22,'#3f7fb0');eq(-70,14,14,36,22,'#3f7fb0');eq(-55,14,14,36,22,'#3f7fb0');
eq(-175,97,20,30,10,'#1fa8c9');
eq(-175,-97,20,30,10,'#c43aa8');
eq(-100,-118,10,8,6,'#2ecc71');

var gP=grp('pw');
path(gP,[[345,-100],[205,-100]],-6,C.pw,{w:6});
vbar(gP,205,-100,-6,3,C.pw,6);
path(gP,[[205,-100],[178,-100]],3,C.pw);
path(gP,[[152,-100],[140,-100]],3,C.pw);
path(gP,[[125,-94],[125,-55]],3,C.pw);
path(gP,[[132,-50],[165,-50],[165,-38]],3,C.pw);
path(gP,[[150,-24],[102,-24],[102,-46],[96,-46]],3,C.pw);
path(gP,[[102,-24],[102,46],[96,46]],3,C.pw);
path(gP,[[88,-46],[-16,-46]],3,C.pw,{w:4});
path(gP,[[88,46],[-16,46]],3,C.pw,{w:4});
