 dragging=true;stage.classList.add('drag');
});
stage.addEventListener('pointermove',function(e){
 var p=pts[e.pointerId];if(!p)return;
 var dx=e.clientX-p.x,dy=e.clientY-p.y;p.x=e.clientX;p.y=e.clientY;
 if(npts()===2){
  var k=Object.keys(pts),a=pts[k[0]],b=pts[k[1]],d=Math.hypot(a.x-b.x,a.y-b.y);
  if(pinch0>0)cam.s=Math.max(.25,Math.min(5,s0*d/pinch0));
 }else if(e.shiftKey||e.buttons===2||panMode){cam.px+=dx;cam.py+=dy;}
 else{cam.ry+=dx*.4;cam.rx=Math.max(-90,Math.min(8,cam.rx-dy*.4));}
 render();
});
function up(e){delete pts[e.pointerId];if(!npts()){dragging=false;stage.classList.remove('drag');}}
stage.addEventListener('pointerup',up);stage.addEventListener('pointercancel',up);
stage.addEventListener('contextmenu',function(e){e.preventDefault();});
stage.addEventListener('wheel',function(e){
 e.preventDefault();cancelAnimationFrame(anim);
 cam.s=Math.max(.25,Math.min(5,cam.s*Math.exp(-e.deltaY*.001)));render();
},{passive:false});
window.addEventListener('resize',render);

document.querySelectorAll('[data-v]').forEach(function(b){
 b.addEventListener('click',function(){var v=VIEWS[b.getAttribute('data-v')];var t=camFor(v);t.ex=cam.ex;tweenTo(t,900);});
});
$('#bpan').onclick=function(){panMode=!panMode;this.classList.toggle('on',panMode);};
$('#bauto').onclick=function(){auto=!auto;this.classList.toggle('on',auto);};
$('#breset').onclick=function(){setLayers(ALL);showStep(STEPS.length-1);};
$('#rex').addEventListener('input',function(e){cancelAnimationFrame(anim);cam.ex=+e.target.value;render();});
(function loop(){if(auto&&!dragging){cam.ry+=.25;render();}requestAnimationFrame(loop);})();

function toast(t){var el=$('#toast');el.textContent=t;el.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(function(){el.hidden=true;},4500);}
$('#bar').onclick=function(){
 var v=$('#video'),btn=this;
 if(stage.classList.contains('ar')){
  if(v.srcObject)v.srcObject.getTracks().forEach(function(t){t.stop();});
  v.srcObject=null;stage.classList.remove('ar');btn.classList.remove('on');return;
 }
 if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){toast('Este navegador o contexto no permite cámara (se requiere HTTPS).');return;}
 navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'},audio:false}).then(function(st){
  v.srcObject=st;return v.play();
 }).then(function(){stage.classList.add('ar');btn.classList.add('on');})
 .catch(function(err){toast('No se pudo activar la cámara ('+(err&&err.name?err.name:'error')+'). Revisa el permiso del navegador.');});
};

/* ---------- pestañas ---------- */
document.querySelectorAll('.tabs button').forEach(function(b){
 b.addEventListener('click',function(){
  document.querySelectorAll('.tabs button').forEach(function(x){x.classList.toggle('on',x===b);});
  ['tour','layers','comp'].forEach(function(t){$('#tab-'+t).hidden=(t!==b.getAttribute('data-tab'));});
 });
});

applyLayers();
showStep(0,true);
})();
</script>
</body>
</html>
